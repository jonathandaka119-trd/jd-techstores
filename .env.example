# ══════════════════════════════════════════════════════════════════════════════
#  JD TechStores – Environment Variables
#  Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── YooKassa (payment processing) ────────────────────────────────────────────
# Get from: https://yookassa.ru → Merchant profile → Shop settings
# VITE_YOOKASSA_SHOP_ID is safe to expose on the frontend.
# YOOKASSA_SECRET_KEY must be added as a Supabase Edge Function secret ONLY
#   → Supabase Dashboard → Edge Functions → Secrets → YOOKASSA_SECRET_KEY
VITE_YOOKASSA_SHOP_ID=your-shop-id
VITE_YOOKASSA_RETURN_URL=https://yourdomain.ru/order-confirmation

# ─── SendGrid (transactional emails) ──────────────────────────────────────────
# SENDGRID_API_KEY must be added as a Supabase Edge Function secret ONLY
#   → Supabase Dashboard → Edge Functions → Secrets → SENDGRID_API_KEY
# The from-email below is safe to put here.
SENDGRID_FROM_EMAIL=noreply@jdtechstores.ru

# ─── Cloudinary (product image uploads) ───────────────────────────────────────
# Get from: https://cloudinary.com → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ─── Google Maps (address autocomplete at checkout) ───────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
